<?xml version="1.0"?>

<robot name="four_wheel_robot">

    <material name="blue">
        <color rgba="0 0.3 1 1"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
    </material>



    <link name="base_link">

    <inertial>
        <mass value="10.0"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <inertia
            ixx="0.2417"
            ixy="0.0"
            ixz="0.0"
            iyy="0.5667"
            iyz="0.0"
            izz="0.7667"/>
    </inertial>
        <visual>
            <geometry>
                <box size="0.8 0.5 0.2"/>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
<collision>
    <geometry>
        <box size="0.8 0.5 0.2"/>
    </geometry>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
</collision>

    </link>



    <link name="front_left_wheel">

    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
            ixx="0.0072"
            ixy="0.0"
            ixz="0.0"
            iyy="0.0072"
            iyz="0.0"
            izz="0.0072"/>
    </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
         </collision>

    </link>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.3 0.29 0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <link name="front_right_wheel">

    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
            ixx="0.0072"
            ixy="0.0"
            ixz="0.0"
            iyy="0.0072"
            iyz="0.0"
            izz="0.0072"/>
    </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
</collision>

    </link>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.3 -0.29 0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <link name="rear_left_wheel">
    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
            ixx="0.0072"
            ixy="0.0"
            ixz="0.0"
            iyy="0.0072"
            iyz="0.0"
            izz="0.0072"/>
    </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
</collision>
    </link>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.3 0.29 0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <link name="rear_right_wheel">
    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
            ixx="0.0072"
            ixy="0.0"
            ixz="0.0"
            iyy="0.0072"
            iyz="0.0"
            izz="0.0072"/>
    </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
</collision>
    </link>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.3 -0.29 0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="front_left_wheel"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
    </plugin>
  </gazebo>


</robot>

